[Unit]
Description=KMinion - Prometheus Exporter fuer Apache Kafka
After=network-online.target kafka.service
Wants=network-online.target

[Service]
Type=simple
Environment=CONFIG_FILEPATH={{ kminion_config_path }}
WorkingDirectory={{ kminion_install_dir }}
ExecStart={{ kminion_install_dir }}/kminion
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
